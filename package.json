{
  "name": "ahuzot-moses",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "licenses:check": "node scripts/check-licenses.mjs",
    "secrets:check": "node scripts/secret-scan/check-secrets.mjs --history",
    "audit:prod": "npm audit --audit-level=high",
    "verify": "npm run check && npm run test && npm run build && node scripts/check-build-output.mjs && npm run secrets:check && npm run licenses:check && npm run audit:prod",
    "launch:check": "node scripts/check-launch-ready.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.3",
    "astro": "^7.4.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
