{
  "name": "ahuzot-moses",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "photos:add": "node scripts/photos/add-photo.mjs",
    "fonts:build": "node scripts/fonts/subset-fonts.mjs",
    "photos:check": "node scripts/photos/check-photos.mjs",
    "budget:check": "node scripts/budget/check-budget.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "secrets:check": "node scripts/secret-scan/check-secrets.mjs --history",
    "audit:prod": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run build && node scripts/check-build-output.mjs && npm run test:e2e && npm run budget:check && npm run photos:check && npm run secrets:check && npm run licenses:check && npm run audit:prod",
    "launch:check": "node scripts/check-launch-ready.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.3",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "astro": "^7.4.4",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
