---
/** A legal or accessibility page in one language: /privacy, /terms, /cancellation, /accessibility. */
import { render, type CollectionEntry } from 'astro:content';
import { tableOfContents } from '@domain/text/table-of-contents';
import BaseLayout from '@components/layout/BaseLayout.astro';
import CoordinatorCard from '@components/legal/CoordinatorCard.astro';
import DraftNotice from '@components/legal/DraftNotice.astro';
import LegalHead from '@components/legal/LegalHead.astro';
import LegalToc from '@components/legal/LegalToc.astro';
import type { Locale } from '@i18n/locales';

interface Props {
  /** The page's entry: its id is "<language>/<page>". */
  entry: CollectionEntry<'legal'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const slug = entry.id.split('/')[1];
const { Content, headings } = await render(entry);
const toc = tableOfContents(headings);
const { title, description, updated, draft, coordinator } = entry.data;
---

<BaseLayout locale={locale} path={`/${slug}`} title={title} description={description}>
  <LegalHead locale={locale} title={title} description={description} updated={updated} />
  <div class="container section legal" data-has-toc={toc.length > 0 ? '' : undefined}>
    {toc.length > 0 && <LegalToc locale={locale} entries={toc} />}
    <div class="legal__text">
      {draft && <DraftNotice locale={locale} text={draft} />}
      <Content />
      {coordinator && <CoordinatorCard locale={locale} />}
    </div>
  </div>
</BaseLayout>

<style>
  .legal__text {
    min-inline-size: 0;
    max-inline-size: 42rem;
    font-size: 1.03rem;
    line-height: 1.75;
  }

  .legal__text :global(h2) {
    margin-block: var(--space-8) var(--space-3);
    scroll-margin-block-start: var(--space-6);
  }

  /* a short gold bar under each section heading; the heart rule stays on the page head */
  .legal__text :global(h2)::after {
    content: '';
    display: block;
    inline-size: 2.5rem;
    block-size: 3px;
    margin-block-start: var(--space-2);
    background: var(--color-accent);
  }

  .legal__text :global(h2:focus) {
    outline: none;
  }

  .legal__text :global(h2:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
  }

  .legal__text :global(.table-scroll) {
    margin-block: var(--space-4);
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .legal__text :global(.table-scroll:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .legal__text :global(table) {
    inline-size: 100%;
    min-inline-size: 30rem;
    border-collapse: collapse;
  }

  .legal__text :global(th),
  .legal__text :global(td) {
    padding: var(--space-2) var(--space-3);
    border-block-end: 1px solid var(--color-border);
    text-align: start;
    vertical-align: top;
  }

  .legal__text :global(th) {
    background: var(--color-surface);
  }

  @media (min-width: 62rem) {
    .legal[data-has-toc] {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--space-12);
    }
  }
</style>
