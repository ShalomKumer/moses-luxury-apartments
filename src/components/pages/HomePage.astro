---
/** Home: the place, the cabins, and how to reach us, in one language. */
import { getCollection } from 'astro:content';
import CabinCard from '@components/cabin/CabinCard.astro';
import ContactDetails from '@components/contact/ContactDetails.astro';
import BaseLayout from '@components/layout/BaseLayout.astro';
import { getMessages } from '@i18n/get-messages';
import type { Locale } from '@i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getMessages(locale);
const cabins = (await getCollection('cabins')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout locale={locale} path="/" title={t.brand.name}>
  <section class="section hero">
    <div class="container">
      <h1>{t.brand.name}</h1>
      <p class="hero__tagline">{t.brand.tagline}</p>
      <p>{t.home.intro}</p>
    </div>
  </section>

  <section id="cabins" class="section" aria-labelledby="cabins-title">
    <div class="container">
      <h2 id="cabins-title">{t.home.cabinsHeading}</h2>
      <ul role="list" class="cabins">
        {cabins.map((cabin) => (
          <li>
            <CabinCard cabin={cabin} locale={locale} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ContactDetails locale={locale} />
</BaseLayout>

<style>
  .hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__tagline {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .cabins {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-6);
  }

  .cabins > li {
    display: flex;
  }

  .cabins > li > :global(*) {
    flex: 1;
  }
</style>
