---
/** Business details and the legal links, on every page (L1-L3, H4, A6, L11), in the page's language. */
import { getCollection } from 'astro:content';
import Icon from '@components/ui/Icon.astro';
import { SITE } from '@config/site';
import { gmailComposeLink } from '@domain/booking/gmail-link';
import { telLink } from '@domain/booking/tel-link';
import { getMessages } from '@i18n/get-messages';
import type { Locale } from '@i18n/locales';
import { localizedPath } from '@i18n/paths';

interface Props {
  locale: Locale;
  /** The page's own address without a language; the policy that matches it is marked as the current one. */
  path: string;
}

const { locale, path } = Astro.props;
const t = getMessages(locale);
const legalPages = (await getCollection('legal'))
  .filter((page) => page.id.startsWith(`${locale}/`))
  .sort((a, b) => a.data.order - b.data.order);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <section aria-labelledby="footer-business">
      <h2 id="footer-business" class="site-footer__title">
        {t.brand.name}
      </h2>
      <p>
        {t.business.legalName}, {t.business.businessNumber}
        <br />
        {t.business.address}
      </p>
      <p>
        {SITE.phones.map((phone) => (
          <>
            <Icon name="phone" />
            <span class="visually-hidden">{t.common.phone}: </span>
            <a href={telLink(phone.display) ?? undefined}>
              <bdi>{phone.display}</bdi>
            </a>
            <br />
          </>
        ))}
        <Icon name="mail" />
        <span class="visually-hidden">{t.common.email}: </span>
        <a href={`mailto:${SITE.email}`}>
          <bdi dir="ltr">{SITE.email}</bdi>
        </a>
        {' · '}
        <a href={gmailComposeLink(SITE.email, '', '')} target="_blank" rel="noopener noreferrer">
          {t.common.gmail}
          <span class="visually-hidden"> {t.contact.newTabHint}</span>
        </a>
      </p>
    </section>
    <nav aria-labelledby="footer-legal">
      <h2 id="footer-legal" class="site-footer__title">
        {t.footer.legalHeading}
      </h2>
      <ul role="list">
        {legalPages.map((page) => (
          <li>
            <a
              href={localizedPath(`/${page.id.split('/')[1]}`, locale)}
              aria-current={path === `/${page.id.split('/')[1]}` ? 'page' : undefined}
            >
              {page.data.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-12);
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-8);
    /* room under the last line for the back-to-top button, so it never covers a link (2.4.11) */
    padding-block: var(--space-8) calc(var(--space-8) + 3.5rem);
  }

  .site-footer__title {
    font-size: var(--text-base);
  }

  .site-footer li a {
    display: inline-block;
    padding-block: var(--space-2);
  }

  /* the current policy: bold with a gold bar, so it is not told apart by colour alone */
  .site-footer li a[aria-current='page'] {
    font-weight: 700;
    border-block-end: 3px solid var(--color-accent);
  }
</style>
