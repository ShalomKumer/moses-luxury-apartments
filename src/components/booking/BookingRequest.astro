---
/**
 * The booking request: which apartment (on the home page; an apartment's own page has it fixed), the two dates, the
 * couples, the children and the total of guests, a name, the WhatsApp and Gmail buttons, and the message that will open. It is a group of
 * controls, not a form: nothing is submitted to the site, and no availability is looked up (L5, L10, H4). Without
 * JavaScript the buttons still open a plain message.
 */
import type { CollectionEntry } from 'astro:content';
import BookingDates from '@components/booking/BookingDates.astro';
import BookingGuests from '@components/booking/BookingGuests.astro';
import BookingLinks from '@components/booking/BookingLinks.astro';
import BookingName from '@components/booking/BookingName.astro';
import { SITE, WHATSAPP_PHONE } from '@config/site';
import { buildBookingMessage } from '@domain/booking/booking-message';
import { maxGuestsOf } from '@domain/booking/guests';
import { toInternationalDigits } from '@domain/booking/phone-number';
import { getMessages } from '@i18n/get-messages';
import type { Locale } from '@i18n/locales';
import { pick } from '@i18n/pick';

interface Props {
  locale: Locale;
  cabins: CollectionEntry<'cabins'>[];
  /** True on an apartment's own page: the one cabin given is the page's, so there is no apartment to choose. */
  fixed?: boolean;
  /** An id that lets a link jump straight to the request (the phone's jump button). */
  id?: string;
}

const { locale, cabins, fixed = false, id } = Astro.props;
const t = getMessages(locale);
const request = t.home.request;
const units = cabins.map((cabin) => ({ id: cabin.id, name: pick(cabin.data.name, locale), max: cabin.data.maxGuests }));
const maxGuests = maxGuestsOf(units.map((unit) => unit.max));
const fixedName = fixed ? (units[0]?.name ?? null) : null;
// without the script the message still has its name line, for the guest to fill in the app
const message = buildBookingMessage(t.booking.message, fixedName, null, undefined, { name: '' });
---

<div
  class:list={['request', { 'request--fixed': fixed }]}
  id={id}
  tabindex={id ? -1 : undefined}
  role="group"
  aria-label={request.heading}
  data-request-bar
  data-phone-digits={toInternationalDigits(WHATSAPP_PHONE) ?? ''}
  data-email={SITE.email}
  data-texts={JSON.stringify(t.booking.message)}
  data-problems={JSON.stringify(request.problems)}
  data-cap-note={request.capNote}
  data-max-guests={maxGuests}
  data-unit-name={fixedName ?? undefined}
>
  <div class="request__fields">
    {!fixed && (
      <div class="field request__unit">
        <label for="request-unit">{request.unit}</label>
        <select id="request-unit" data-request-unit>
          <option value="">{request.unitAny}</option>
          {units.map((unit) => (
            <option value={unit.id} data-max={unit.max}>
              {unit.name}
            </option>
          ))}
        </select>
      </div>
    )}
    <BookingDates idPrefix="request" checkInLabel={request.checkIn} checkOutLabel={request.checkOut} />
    <BookingGuests locale={locale} idPrefix="request" />
    <BookingName locale={locale} idPrefix="request" />
    <p class="request__cap-note" data-guests-note role="status"></p>
  </div>
  <p class="request__problem" data-request-problem role="alert"></p>
  <BookingLinks locale={locale} name={fixedName ?? t.brand.name} cabinName={fixedName} message={message} />
  <p class="request__preview" aria-live="polite">
    <small>{request.previewLabel}</small>
    <span data-request-message>{message}</span>
  </p>
</div>

<script>
  import { initBookingRequest } from './request-controller';

  document.querySelectorAll<HTMLElement>('[data-request-bar]').forEach(initBookingRequest);
</script>

<style>
  .request {
    container-type: inline-size;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-block-start: 4px solid var(--color-accent);
    border-radius: var(--radius);
  }

  .request__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  /* the choices only write the message, so without the script they are not shown; the buttons still work */
  .request:not([data-enhanced]) .request__fields {
    display: none;
  }

  .request__unit,
  .request__fields :global(.request__total),
  .request__fields :global(.request__name),
  .request__cap-note {
    grid-column: 1 / -1;
  }

  .request__cap-note {
    margin: 0;
    color: var(--color-taken-text);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .request__cap-note:empty {
    display: none;
  }

  /* wide: the apartment and the two dates in one row, then the couples, the children, the total and the name */
  @container (min-width: 46rem) {
    .request__fields {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .request__unit {
      grid-column: span 2;
    }

    .request__fields :global(.request__total),
    .request__fields :global(.request__name) {
      grid-column: auto;
    }

    .request__cap-note {
      grid-column: 1 / -1;
    }
  }

  .request__problem {
    margin: 0;
    color: var(--color-taken-text);
    font-weight: 600;
  }

  .request__problem:empty {
    display: none;
  }

  .request__preview {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg);
    border-inline-start: 4px solid var(--color-accent);
    border-radius: calc(var(--radius) / 2);
    font-size: var(--text-sm);
    white-space: pre-wrap;
  }

  .request__preview small {
    color: var(--color-text-muted);
    font-weight: 600;
  }
</style>
