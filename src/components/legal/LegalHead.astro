---
/** The head of a legal page on the paper tone: the title, the heart rule, one sentence on the page, and its date. */
import HeartRule from '@components/ui/HeartRule.astro';
import UpdatedDate from '@components/ui/UpdatedDate.astro';
import type { Locale } from '@i18n/locales';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  updated: string;
}

const { locale, title, description, updated } = Astro.props;
---

<header class="legal-head">
  <div class="container">
    <h1>{title}</h1>
    <HeartRule />
    <p class="legal-head__summary">{description}</p>
    <UpdatedDate locale={locale} date={updated} />
  </div>
</header>

<style>
  .legal-head {
    padding-block: var(--space-8);
    background: var(--color-surface);
    border-block-end: 1px solid var(--color-border);
  }

  .legal-head h1 {
    max-inline-size: 24ch;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .legal-head__summary {
    max-inline-size: 44rem;
    font-size: var(--text-lg);
  }

  .legal-head :global(p:last-child) {
    margin-block-end: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
