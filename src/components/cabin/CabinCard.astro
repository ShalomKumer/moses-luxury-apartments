---
/** One cabin in the list on the home page: photo, name, summary, capacity, and a link to its page. */
import type { CollectionEntry } from 'astro:content';
import { fillTemplate } from '@domain/text/fill-template';
import { getMessages } from '@i18n/get-messages';
import type { Locale } from '@i18n/locales';
import { localizedPath } from '@i18n/paths';
import { pick } from '@i18n/pick';

interface Props {
  cabin: CollectionEntry<'cabins'>;
  locale: Locale;
}

const { cabin, locale } = Astro.props;
const t = getMessages(locale);
const { maxGuests, photos } = cabin.data;
const name = pick(cabin.data.name, locale);
const summary = pick(cabin.data.summary, locale);
const cover = photos[0];
---

<article class="cabin-card">
  <img
    src={cover.src}
    alt={pick(cover.alt, locale)}
    width={cover.width}
    height={cover.height}
    loading="lazy"
    decoding="async"
  />
  <div class="cabin-card__body">
    <h3>{name}</h3>
    <p>{summary}</p>
    <p class="cabin-card__meta">{fillTemplate(t.cabin.guestsUpTo, { count: maxGuests })}</p>
    <a class="button" href={localizedPath(`/cabins/${cabin.id}`, locale)}>
      {t.cabin.details}<span class="visually-hidden"> - {name}</span>
    </a>
  </div>
</article>

<style>
  .cabin-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .cabin-card img {
    aspect-ratio: 3 / 2;
    object-fit: cover;
    width: 100%;
  }

  .cabin-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    flex: 1;
  }

  .cabin-card__body p {
    margin: 0;
  }

  .cabin-card__meta {
    color: var(--color-text-muted);
  }

  .cabin-card .button {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
