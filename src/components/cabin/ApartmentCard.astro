---
/**
 * One apartment as a compact card (the "you might also like" band under an apartment's details): its photo (3:2), its name
 * as the link to its page, and the guests it takes. The whole card is the link (the name's link is stretched over it), so a
 * tap anywhere opens the apartment. On a phone the photo is the smallest file of the photo, as in a row (`ApartmentRow`).
 */
import type { CollectionEntry } from 'astro:content';
import { toPagePhoto } from '@components/cabin/cabin-photo';
import { fillTemplate } from '@domain/text/fill-template';
import { getMessages } from '@i18n/get-messages';
import type { Locale } from '@i18n/locales';
import { localizedPath } from '@i18n/paths';
import { pick } from '@i18n/pick';

interface Props {
  cabin: CollectionEntry<'cabins'>;
  locale: Locale;
}

/** A phone (up to 30rem, 480 px): it loads the smallest file; a wider screen picks from the whole `srcset`. */
const PHONE_MEDIA = '(max-width: 30rem)';

const { cabin, locale } = Astro.props;
const t = getMessages(locale);
const name = pick(cabin.data.name, locale);
const cover = toPagePhoto(cabin.data.photos[0], locale);
---

<article class="card">
  <picture class="card__picture">
    {cover.srcset && <source media={PHONE_MEDIA} srcset={cover.small} />}
    <img
      class="card__photo"
      src={cover.src}
      srcset={cover.srcset}
      sizes="(min-width: 48rem) 30vw, 62vw"
      alt=""
      width={cover.width}
      height={cover.height}
      loading="lazy"
      decoding="async"
    />
  </picture>
  <div class="card__body">
    <h3>
      <a class="card__link" href={localizedPath(`/cabins/${cabin.id}`, locale)}>
        {name}
      </a>
    </h3>
    <p>{fillTemplate(t.cabin.guestsUpTo, { count: cabin.data.maxGuests })}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) * 1.5);
  }

  .card__picture {
    display: block;
  }

  .card__photo {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .card__body {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    padding: var(--space-3) var(--space-4) var(--space-4);
  }

  .card__body h3,
  .card__body p {
    margin: 0;
  }

  .card__body h3 {
    font-size: var(--text-lg);
    overflow-wrap: anywhere;
  }

  .card__body p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* the link covers the whole card, and the focus ring goes round the card */
  .card__link {
    color: inherit;
    text-decoration: none;
  }

  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover {
    border-color: var(--color-text);
  }

  .card:has(.card__link:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .card__link:focus-visible {
    outline: none;
  }
</style>
