---
/**
 * An apartment's photos: one large photo and up to four small ones, with "all photos" opening the viewer. Each photo is a
 * link to the full file, so the page works without JavaScript (the grid's photos then show in a plain grid, and the rest
 * as links named by their alt text: a photo beyond the grid is not an <img> in the page, so it weighs nothing until it is
 * opened); the controller turns the links into a viewer dialog with keyboard control (A3). On a phone the grid shows the
 * main photo and, under it, three small ones; a tap on
 * any of them opens the viewer. The viewer is a frame of one fixed size: the photo fits inside a dark stage (a tall photo
 * and a wide one take the same room), the arrows stay at the sides of the stage and under it is only a counter, "3 / 12",
 * so no control moves from photo to photo; the photo's description stays in a visually hidden line that a screen reader
 * announces (A2). A tap anywhere but on an arrow or the close button closes the viewer, the photo included
 * (`gallery-controller.ts`). Every label is in the page's language.
 */
import type { PagePhoto } from '@components/cabin/cabin-photo';
import Icon from '@components/ui/Icon.astro';
import { galleryShape } from '@domain/gallery/gallery-shape';
import { fillTemplate } from '@domain/text/fill-template';
import { getMessages } from '@i18n/get-messages';
import type { Locale } from '@i18n/locales';

interface Props {
  locale: Locale;
  name: string;
  /** The photos, with their alt text already in the page's language. */
  photos: PagePhoto[];
}

const { locale, name, photos } = Astro.props;
const t = getMessages(locale).gallery;
const shape = galleryShape(photos.length);
---

<section
  class:list={['gallery', `gallery--n${shape.shown}`]}
  data-gallery
  data-position-template={t.position}
  aria-labelledby="gallery-title"
>
  <h2 id="gallery-title" class="visually-hidden">
    {fillTemplate(t.heading, { name })}
  </h2>
  <ul role="list" class="gallery__grid">
    {photos.map((photo, index) =>
      index < shape.shown ? (
        <li class="gallery__item">
          <a
            href={photo.full}
            data-gallery-item={index}
            data-alt={photo.alt}
            aria-label={fillTemplate(t.open, { n: index + 1, total: photos.length, alt: photo.alt })}
          >
            <img
              src={photo.src}
              srcset={photo.srcset}
              sizes={index === 0 ? '(min-width: 48rem) 66vw, 100vw' : '(min-width: 48rem) 33vw, 34vw'}
              alt=""
              width={photo.width}
              height={photo.height}
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
              decoding="async"
            />
          </a>
        </li>
      ) : (
        <li class="gallery__item gallery__item--extra">
          <a href={photo.full} data-gallery-item={index} data-alt={photo.alt}>
            {photo.alt}
          </a>
        </li>
      ),
    )}
  </ul>
  {shape.hasViewerControls && (
    <button type="button" class="button button--secondary gallery__all" data-gallery-all>
      {t.all}
    </button>
  )}

  <dialog class="gallery__dialog" data-gallery-dialog aria-label={fillTemplate(t.dialog, { name })}>
    <figure class="gallery__figure">
      <div class="gallery__stage" data-gallery-stage>
        {/* lazy: the viewer is closed, and a browser fetches even a hidden image unless it is lazy: without this the first
            photo came twice on every page, once here at 1280 px and once in the grid. The controller sets the file when it opens. */}
        <img data-gallery-image src={photos[0].src} alt={photos[0].alt} loading="lazy" />
        {shape.hasViewerControls && (
          <>
            <button type="button" class="gallery__arrow gallery__arrow--previous" data-gallery-prev>
              <Icon name="chevron-left" />
              <span class="visually-hidden">{t.previous}</span>
            </button>
            <button type="button" class="gallery__arrow gallery__arrow--next" data-gallery-next>
              <Icon name="chevron-right" />
              <span class="visually-hidden">{t.next}</span>
            </button>
          </>
        )}
      </div>
      <figcaption class="gallery__caption">
        {/* the counter is for the eyes; the line a screen reader announces (the description and the position) is hidden */}
        <span class="gallery__counter" data-gallery-counter dir="ltr" aria-hidden="true"></span>
        <span class="visually-hidden" data-gallery-caption aria-live="polite"></span>
      </figcaption>
    </figure>
    <button type="button" class="gallery__close" data-gallery-close>
      <Icon name="x" />
      <span class="visually-hidden">{t.close}</span>
    </button>
  </dialog>
</section>

<script>
  import { initGallery } from './gallery-controller';

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
</script>

<style>
  .gallery {
    position: relative;
  }

  /* without the script: every photo, in a plain grid, each a link to the full file */
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-3);
  }

  .gallery__item a {
    display: block;
    height: 100%;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* a photo beyond the grid, without the script: a link with the photo's words */
  .gallery__item--extra a {
    height: auto;
    padding-block: var(--space-2);
  }

  .gallery:not([data-enhanced]) .gallery__all {
    display: none;
  }

  /*
   * With the script, a phone shows the main photo, up to three small ones under it in a row and the
   * "all photos" button below them; the viewer reaches the rest. A photo beyond the small ones is hidden, and a hidden lazy
   * picture is never fetched.
   */
  .gallery[data-enhanced] .gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }

  /* a gallery of two or three photos has fewer small ones: they share the width, with no empty cell */
  .gallery--n1[data-enhanced] .gallery__grid,
  .gallery--n2[data-enhanced] .gallery__grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .gallery--n3[data-enhanced] .gallery__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .gallery[data-enhanced] .gallery__item:first-child {
    grid-column: 1 / -1;
  }

  .gallery[data-enhanced] .gallery__item:nth-child(n + 5) {
    display: none;
  }

  .gallery[data-enhanced] .gallery__all {
    margin-block-start: var(--space-3);
  }

  @media (min-width: 48rem) {
    .gallery__all {
      position: absolute;
      inset-block-end: var(--space-3);
      inset-inline-end: var(--space-3);
      margin-block-start: 0;
    }

    .gallery[data-enhanced] .gallery__grid {
      --gallery-height: clamp(20rem, 38vw, 30rem);

      display: grid;
      grid-template-rows: repeat(2, minmax(0, 1fr));
      gap: var(--space-2);
      height: var(--gallery-height);
    }

    .gallery[data-enhanced] .gallery__item:not(:first-child) {
      display: block;
    }

    .gallery[data-enhanced] .gallery__item:first-child {
      grid-column: auto;
    }

    .gallery[data-enhanced] .gallery__item.gallery__item--extra {
      display: none;
    }

    .gallery[data-enhanced] .gallery__item img {
      aspect-ratio: auto;
    }

    /* the photo count picks the arrangement; the first photo is the large one */
    .gallery--n1[data-enhanced] .gallery__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr);
      max-inline-size: 45rem;
    }

    .gallery--n2[data-enhanced] .gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: minmax(0, 1fr);
    }

    .gallery--n3[data-enhanced] .gallery__grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }

    .gallery--n4[data-enhanced] .gallery__grid,
    .gallery--n5[data-enhanced] .gallery__grid {
      grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr));
    }

    .gallery--n3[data-enhanced] .gallery__item:first-child,
    .gallery--n4[data-enhanced] .gallery__item:first-child,
    .gallery--n5[data-enhanced] .gallery__item:first-child {
      grid-row: span 2;
    }

    /* with four photos the last small one takes the whole second row beside the large photo */
    .gallery--n4[data-enhanced] .gallery__item:nth-child(4) {
      grid-column: span 2;
    }
  }

  /*
   * The viewer is one frame of a fixed size, so nothing in it moves from photo to photo: a wide window on a desktop, a window
   * of about 70% of the screen high on a phone, with the page showing round it. It is a grid only while open (a closed dialog stays hidden). Inside, the photo fits a dark stage
   * (object-fit: contain), so a tall photo and a wide one take the same room; the arrows sit at the sides of the stage, the
   * close button in the corner, and under the stage is one line with the counter.
   */
  .gallery__dialog {
    box-sizing: border-box;
    width: min(94vw, 64rem);
    max-width: none;
    height: min(90vh, 46rem);
    max-height: none;
    margin: auto;
    padding: 3.5rem var(--space-4) var(--space-4);
    border: none;
    border-radius: calc(var(--radius) * 2);
    background: var(--color-surface);
    color: var(--color-text);
    overflow: hidden;
  }

  .gallery__dialog[open] {
    display: grid;
  }

  .gallery__dialog::backdrop {
    background: rgb(0 0 0 / 0.75);
  }

  @supports (height: 100dvh) {
    .gallery__dialog {
      height: min(90dvh, 46rem);
    }
  }

  /* a phone: a window of about 70% of the screen high (not lower than 22 rem where the screen allows), the page dimmed round it */
  @media (max-width: 47.99rem) {
    .gallery__dialog {
      width: 92vw;
      height: max(70vh, min(22rem, 90vh));
      padding-inline: var(--space-2);
    }

    @supports (height: 100dvh) {
      .gallery__dialog {
        height: max(70dvh, min(22rem, 90dvh));
      }
    }
  }

  .gallery__figure {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: var(--space-2);
    min-height: 0;
    margin: 0;
  }

  .gallery__stage {
    position: relative;
    min-height: 0;
    overflow: hidden;
    background: var(--color-scrim);
    border-radius: var(--radius);
    /* a finger's sideways movement is a swipe; the page behind is inert while the viewer is open */
    touch-action: pan-y;
  }

  .gallery__stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* one line, always: the stage above never grows or shrinks; the counter is a small pill in the middle of it */
  .gallery__caption {
    display: grid;
    place-items: center;
    height: 2.25rem;
  }

  .gallery__counter {
    padding: var(--space-1) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }

  .gallery__arrow,
  .gallery__close {
    display: grid;
    place-items: center;
    width: var(--target-size);
    height: var(--target-size);
    padding: 0;
    background: var(--color-surface);
    border: 2px solid var(--color-text);
    border-radius: 50%;
    color: var(--color-text);
    cursor: pointer;
  }

  .gallery__arrow:hover,
  .gallery__close:hover {
    background: var(--color-bg);
  }

  .gallery__arrow {
    position: absolute;
    inset-block-start: 50%;
    transform: translateY(-50%);
  }

  /* the previous arrow is at the start of the line, the next one at its end, whichever way the page reads */
  .gallery__arrow--previous {
    inset-inline-start: var(--space-3);
  }

  .gallery__arrow--next {
    inset-inline-end: var(--space-3);
  }

  .gallery__close {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-end: var(--space-2);
  }

  .gallery__arrow :global(.icon),
  .gallery__close :global(.icon) {
    width: 1.5rem;
    height: 1.5rem;
    margin-inline-end: 0;
  }

  /* in a right-to-left page the arrows point the other way: previous goes towards the right */
  :global(html[dir='rtl']) .gallery__arrow :global(.icon) {
    transform: scaleX(-1);
  }
</style>
