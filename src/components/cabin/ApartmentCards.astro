---
/**
 * The other apartments as a row of compact cards: on a phone one row that moves sideways (the next card shows its edge, so
 * it can be seen that there is more), on a wide screen the cards side by side. It draws the list it is given.
 */
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@i18n/locales';
import ApartmentCard from './ApartmentCard.astro';

interface Props {
  cabins: CollectionEntry<'cabins'>[];
  locale: Locale;
}

const { cabins, locale } = Astro.props;
---

<ul role="list" class="cards">
  {cabins.map((cabin) => (
    <li>
      <ApartmentCard cabin={cabin} locale={locale} />
    </li>
  ))}
</ul>

<script>
  // a card reached by the keyboard is brought wholly into view, so its focus ring is never cut off by the edge of the row
  document.querySelectorAll<HTMLElement>('.cards').forEach((row) => {
    row.addEventListener('focusin', (event) => {
      (event.target as Element).closest('li')?.scrollIntoView({ inline: 'nearest', block: 'nearest' });
    });
  });
</script>

<style>
  /* a phone: one row, each card most of the width, snapping into place */
  .cards {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 72%;
    gap: var(--space-3);
    padding: var(--space-2);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-2);
  }

  .cards > li {
    display: grid;
    scroll-snap-align: start;
  }

  @media (min-width: 48rem) {
    .cards {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
      overflow-x: visible;
    }
  }
</style>
