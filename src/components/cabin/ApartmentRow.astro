---
/**
 * One apartment as a large row (the home page and the apartment pages): its photo (3:2) beside its name, summary, capacity and a button to its
 * page. The rows alternate sides by the start and end of the line, so they swap by themselves in right-to-left text.
 * On a phone the photo is the smallest file of the photo (a row is a pointer to another page, not the place to see it);
 * a wider screen picks from the whole `srcset`. The page-weight check reads this phone source (`scripts/budget`).
 */
import type { CollectionEntry } from 'astro:content';
import { toPagePhoto } from '@components/cabin/cabin-photo';
import { fillTemplate } from '@domain/text/fill-template';
import { getMessages } from '@i18n/get-messages';
import type { Locale } from '@i18n/locales';
import { localizedPath } from '@i18n/paths';
import { pick } from '@i18n/pick';

interface Props {
  cabin: CollectionEntry<'cabins'>;
  locale: Locale;
  /** Puts the photo on the other side on a wide screen; the list that draws the rows alternates it. */
  flip?: boolean;
}

/** A phone (up to 30rem, 480 px): it loads the smallest file; a wider stacked row (a tablet) picks from the whole `srcset`. */
const PHONE_MEDIA = '(max-width: 30rem)';

const { cabin, locale, flip = false } = Astro.props;
const t = getMessages(locale);
const { maxGuests, photos } = cabin.data;
const name = pick(cabin.data.name, locale);
const cover = toPagePhoto(photos[0], locale);
---

<article class:list={['row', { 'row--flip': flip }]}>
  <picture class="row__picture">
    {cover.srcset && <source media={PHONE_MEDIA} srcset={cover.small} />}
    <img
      class="row__photo"
      src={cover.src}
      srcset={cover.srcset}
      sizes="(min-width: 48rem) 40vw, 100vw"
      alt={cover.alt}
      width={cover.width}
      height={cover.height}
      loading="lazy"
      decoding="async"
    />
  </picture>
  <div class="row__body">
    <h3>{name}</h3>
    <p>{pick(cabin.data.summary, locale)}</p>
    <p class="row__meta">{fillTemplate(t.cabin.guestsUpTo, { count: maxGuests })}</p>
    <a class="button button--secondary" href={localizedPath(`/cabins/${cabin.id}`, locale)}>
      {t.cabin.details}
      <span class="visually-hidden"> - {name}</span>
    </a>
  </div>
</article>

<style>
  .row {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  .row__picture {
    display: block;
  }

  .row__photo {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: calc(var(--radius) * 2);
  }

  .row__body {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .row__body h3,
  .row__body p {
    margin: 0;
  }

  .row__body h3 {
    font-size: var(--text-xl);
  }

  .row__meta {
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-8);
    }

    /* every second row puts the photo on the other side; `order` follows the text direction */
    .row--flip > .row__picture {
      order: 2;
    }
  }
</style>
