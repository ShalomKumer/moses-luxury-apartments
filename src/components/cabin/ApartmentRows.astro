---
/**
 * The apartments as a list of large rows, shared by the home page (all of them) and the apartment pages (the next few,
 * chosen by `nextApartments`). It draws the list it is given.
 */
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@i18n/locales';
import ApartmentRow from './ApartmentRow.astro';

interface Props {
  cabins: CollectionEntry<'cabins'>[];
  locale: Locale;
}

const { cabins, locale } = Astro.props;
---

<ul role="list" class="rows">
  {cabins.map((cabin) => (
    <li>
      <ApartmentRow cabin={cabin} locale={locale} />
    </li>
  ))}
</ul>

<style>
  .rows {
    display: grid;
    gap: var(--space-8);
  }
</style>
