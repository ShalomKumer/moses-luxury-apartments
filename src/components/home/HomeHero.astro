---
/**
 * The top of the home page: a photo across the full width, the logo's two lines over it on a dark plate, and the
 * booking-request bar (the slot) at its bottom. Text over the photo always sits on the plate (A1).
 */
import type { PagePhoto } from '@components/cabin/cabin-photo';
import { getMessages } from '@i18n/get-messages';
import type { Locale } from '@i18n/locales';

interface Props {
  locale: Locale;
  /** The photo across the top: the cover of the first apartment. */
  photo: PagePhoto;
}

const { locale, photo } = Astro.props;
const t = getMessages(locale);
---

<section class="hero" aria-labelledby="hero-title">
  <img
    class="hero__photo"
    src={photo.src}
    srcset={photo.srcset}
    sizes="100vw"
    alt={photo.alt}
    width={photo.width}
    height={photo.height}
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__inner">
    <div class="container hero__content">
      <h1 id="hero-title">{t.brand.tagline}</h1>
      <p class="hero__slogan">{t.brand.slogan}</p>
      <slot />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 44rem;
    background: var(--color-scrim);
    color: var(--color-on-scrim);
    overflow: clip;
  }

  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The plate fades in from the photo and is solid under the text and the bar, whatever the photo shows. */
  .hero__inner {
    position: relative;
    padding-block: 3.5rem var(--space-6);
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--color-scrim) var(--scrim-strength), transparent) 3rem
    );
  }

  .hero__content {
    display: grid;
    gap: var(--space-3);
  }

  .hero h1 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(1.75rem, 1rem + 3vw, 2.5rem);
    text-wrap: balance;
  }

  .hero__slogan {
    margin: 0 0 var(--space-3);
    max-width: 52ch;
    font-family: var(--font-script);
    font-size: 1.5rem;
    line-height: 1.3;
  }

  /*
   * On a phone the English lines are wider than the Hebrew ones and wrapped to three lines each, so the top of the page
   * grew by about 70 px; a slightly smaller size and no character limit bring them back to two lines, as in Hebrew.
   */
  @media (max-width: 47.99rem) {
    :global(html:lang(en)) .hero h1 {
      max-width: none;
      font-size: 1.5rem;
    }

    :global(html:lang(en)) .hero__slogan {
      font-size: 1.25rem;
    }
  }

  @media (min-width: 48rem) {
    .hero {
      min-height: 50rem;
    }
  }
</style>
